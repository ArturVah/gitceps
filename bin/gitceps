#!/bin/bash
# Turns Gitceps on or off, and switches single reactions on or off.
# Usage:
#   gitceps on | off | status                    for every git repo on this Mac
#   gitceps list                                 each switch, and whether it's on where you are
#   gitceps enable | disable <switch> [--here]   --here: only in the repo you're in
#   gitceps update                               installs the latest version over this one
set -euo pipefail
GITCEPS_HOME="${GITCEPS_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"   # works through symlinks
hooks="$GITCEPS_HOME/hooks"
. "$hooks/lib.sh"   # for enabled()
current=$(git config --global --type=path core.hooksPath || true)   # --type=path expands ~

# push, pull, amend, rebase, clone: those animations. all: every animation. secrets: the secret check (independent of "all").
SWITCHES="push pull amend rebase clone all secrets"

usage() {
  echo "usage: gitceps on | off | status | list | update | enable <switch> [--here] | disable <switch> [--here]" >&2
  echo "switches: $SWITCHES" >&2
  exit 1
}

# Paths are compared as folders, so ~/.gitceps/hooks/ and ~/.gitceps/hooks count as the same.
is_ours() { [ -n "$1" ] && [ "$1" -ef "$hooks" ]; }

case "${1:-}" in
  on)
    if [ -n "$current" ] && ! is_ours "$current"; then
      echo "Your global core.hooksPath is already $current, so Gitceps left it alone." >&2
      echo "To use him in one repo only, run this inside it: git config core.hooksPath \"$hooks\"" >&2
      exit 1
    fi
    git config --global core.hooksPath "$hooks"
    echo "Gitceps is on for every repo. Try a git push." ;;
  off)
    if is_ours "$current"; then
      git config --global --unset core.hooksPath
      echo "Gitceps is off."
    elif [ -z "$current" ]; then
      echo "Gitceps is already off."
    else
      echo "Your global core.hooksPath is $current, not this Gitceps ($hooks), so it was left alone." >&2
      exit 1
    fi
    if is_ours "$(git config --local --type=path core.hooksPath 2>/dev/null || true)"; then
      echo "This repo still turns him on itself. To stop that too: git config --unset core.hooksPath"
    fi ;;
  status)
    if is_ours "$current"; then echo "on"; else echo "off"; fi ;;
  list)
    for name in $SWITCHES; do
      state=off; enabled "$name" && state=on
      note=""; git config --local --get "gitceps.$name" >/dev/null 2>&1 && note="  (set in this repo)"
      printf '%-8s %s%s\n' "$name" "$state" "$note"
    done ;;
  enable | disable)
    name="${2:-}"
    [[ " $SWITCHES " == *" $name "* ]] || usage
    value=true; [ "$1" = disable ] && value=false
    if [ "${3:-}" = --here ]; then
      git rev-parse --git-dir >/dev/null 2>&1 || { echo "--here only works inside a git repo." >&2; exit 1; }
      git config --local "gitceps.$name" "$value"
      where="in this repo"
    else
      git config --global "gitceps.$name" "$value"
      where="everywhere"
    fi
    echo "$name: $([ "$value" = true ] && echo on || echo off) $where" ;;
  update)
    if [ ! -f "$GITCEPS_HOME/VERSION" ]; then   # only install.sh writes it
      echo "This Gitceps in $GITCEPS_HOME didn't come from install.sh, so update it the way you installed it (Homebrew: brew upgrade gitceps)." >&2
      exit 1
    fi
    # exec: the installer replaces this very file.
    exec bash -c 'set -o pipefail; curl -fsSL https://raw.githubusercontent.com/ArturVah/gitceps/main/install.sh | bash' ;;
  *)
    usage ;;
esac
