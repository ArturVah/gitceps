#!/bin/bash
# Push Bro's pre-push hook. Git runs it just before a push.
# It measures what is being pushed, starts the animation in the background,
# and blocks the push if it contains something that looks like a secret.
PB_HOME="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$HOME/Library/Logs/push-bro.log"
ZERO=0000000000000000000000000000000000000000

# Key formats are case-sensitive. "sk-" covers OpenAI and Anthropic keys.
KEY_RE='ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk_live_[A-Za-z0-9]{10,}|(^|[^A-Za-z0-9_-])sk-[A-Za-z0-9_-]{32,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
# A credential assigned a quoted value. Code that only reads one (password = req.body.password) passes.
ASSIGN_RE="(password|passwd|secret|api_?key|token)[\"']?[[:space:]]*[:=][[:space:]]*[\"'][^\"'[:space:]]{8,}[\"']"
FILE_RE='(^|/)(\.env(\.[^/]*)?|id_rsa|id_ed25519|credentials\.json)$|\.pem$'
TEMPLATE_RE='\.env\.(example|sample|template|dist)$'

# Git calls the hook with the remote's name and URL. The cloud shows the repo's name:
# git@github.com:you/app.git -> app
repo=$(basename "${2%/}" .git)
repo=${repo:-$1}

# Git sends one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
refs=$(cat)

# The repo's own pre-push hook goes first (see hooks/forward). If it refuses, so do we.
own="$(git rev-parse --git-common-dir)/hooks/pre-push"
if [ -x "$own" ] && ! [ "$own" -ef "$0" ]; then
  "$own" "$@" <<<"$refs" || exit
fi

tips=(); rewritten=0
while read -r lref lsha rref rsha; do
  [ -z "$lsha" ] || [ "$lsha" = "$ZERO" ] && continue   # no refs, or deleting a remote branch
  tips+=("$lsha")
  # The remote has commits this push would drop: someone pushed first, or history was rewritten.
  if [ "$rsha" != "$ZERO" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
    rewritten=1
  fi
done <<<"$refs"
[ ${#tips[@]} = 0 ] && exit 0

# Commits the remote doesn't have yet, each counted once even when several refs share them.
new_commits() { git log --format= "$@" "${tips[@]}" --not --remotes; }

read -r ins del < <(new_commits --numstat | awk '$1 ~ /^[0-9]+$/ { i += $1; d += $2 } END { print i + 0, d + 0 }')
msg=$(git log -1 --format=%s "${tips[0]}")
secret=$(new_commits --name-only --diff-filter=AM | grep -E "$FILE_RE" | grep -vE "$TEMPLATE_RE" | head -1)
if [ -z "$secret" ]; then
  added=$(new_commits -p -U0 | grep '^+' | grep -v '^+++ ')
  if grep -Eq "$KEY_RE" <<<"$added" || grep -Eiq "$ASSIGN_RE" <<<"$added"; then
    secret="key in code"
  fi
fi

# Git doesn't tell hooks whether --force was given, so read git's own command line.
forced() { ps -o args= -p "$PPID" | grep -Eq -- '(^| )(--force[a-z-]*|-[A-Za-z]*f[A-Za-z]*)( |=|$)| \+[^ ]'; }

total=$((ins + del))
if   [ -n "$secret" ];                then mode=secret
elif [ "$rewritten" = 1 ] && forced;  then mode=force
elif [ "$rewritten" = 1 ];            then mode=rejected   # git will refuse it
elif [ "$total" -le 10 ];             then mode=tiny
elif [ "$total" -ge 10000 ];          then mode=forklift
elif [ "$total" -ge 400 ];            then mode=huge
else                                       mode=normal
fi

# PB_DRY=1 only prints the chosen reaction (for testing without the overlay).
if [ -n "$PB_DRY" ]; then
  echo "push-bro would play: $mode (+$ins -$del, to: $repo, msg: $msg${secret:+, secret: $secret})" >&2
# Launch in the background so the push never waits for the animation.
else ( "$PB_HOME/app/pushbro" --mode "$mode" --ins "$ins" --del "$del" --msg "$msg" --secret "$secret" --remote "$repo" \
    >>"$LOG" 2>&1 & )
fi

if [ "$mode" = secret ]; then
  echo "push-bro: NOPE. That looks like a secret ($secret). Push blocked." >&2
  echo "    If it's a fake test value: git push --no-verify" >&2
  exit 1
fi
exit 0
