#!/bin/bash
# Gitceps' post-merge hook. Git runs it after a merge or pull that brought commits in.
# Only a pull gets a reaction: `git pull` itself, or merging your upstream the way an IDE's
# fetch-then-merge does. Merging a local branch stays quiet.
. "$(dirname "$0")/lib.sh"
run_own "$@"   # git ignores this hook's exit status
enabled all || exit 0

# Git labels its work: "pull ..." during `git pull`, "merge <what>" for a plain merge.
case "${GIT_REFLOG_ACTION:-}" in
  pull*)     pull_reaction ORIG_HEAD HEAD ;;
  "merge "*) is_upstream "${GIT_REFLOG_ACTION#merge }" && pull_reaction ORIG_HEAD HEAD ;;
esac
exit 0
