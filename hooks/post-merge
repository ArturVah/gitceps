#!/bin/bash
# Gitceps' post-merge hook. Git runs it after a merge or pull that brought commits in.
# Only a pull gets a reaction; merging a local branch stays quiet.
. "$(dirname "$0")/lib.sh"
run_own "$@"   # git ignores this hook's exit status
enabled all || exit 0
# The new commits are ORIG_HEAD..HEAD. What got merged is HEAD itself after a fast-forward, or the
# other parent after a merge commit; if that's the upstream, it was a pull even without `git pull`.
pull_reaction ORIG_HEAD HEAD HEAD HEAD^2
exit 0
