#!/bin/bash
# Gitceps turns itself on through git's global core.hooksPath, and while that is set git stops
# looking in each repo's own hooks folder. This script stands in for the other hook names (they
# are symlinks to it) and runs the repo's own hook of the same name, so those keep working.
#
# Not forwarded:
#   push-to-checkout, proc-receive: git changes how it handles a push just because these exist
#   fsmonitor-watchman: git finds it through core.fsmonitor, not by name
#   post-index-change, reference-transaction: git runs them so often that a stand-in would slow
#   down everyday commands
. "$(dirname "$0")/lib.sh"
run_own "$@"
