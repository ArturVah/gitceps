#!/bin/bash
# Gitceps' post-checkout hook. Git runs it after checkout, switch, clone and `worktree add`.
# Only a fresh clone gets a reaction (he walks into an empty gym). Git uses this hook's exit
# status as the checkout's own, so the repo's hook decides it.
. "$(dirname "$0")/lib.sh"
run_own "$@"
status=$?

# A clone checks out from nothing (previous HEAD is all zeros) into a repo's main worktree;
# `worktree add` does the same into a linked worktree, whose git dir differs from the common one.
if [ "$1" = "$ZERO" ] && [ "$(git rev-parse --git-dir)" -ef "$GIT_COMMON" ] && enabled all && enabled clone; then
  play clone --ins "$(git ls-files | wc -l | tr -d ' ')" --msg "$(git log -1 --format=%s 2>/dev/null)" --remote "$(repo_name)"
fi
exit $status
