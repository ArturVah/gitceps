#!/bin/bash
# Gitceps' post-rewrite hook. Git runs it after `commit --amend` and after a rebase, with one
# "<old sha> <new sha>" line per rewritten commit on stdin.
#   amend:  only when the commit was already pushed (he sneaks in to swap a plate)
#   rebase: `git pull --rebase` gets the pull reaction; a rebase you run yourself, of 3+ commits,
#           gets juggled
. "$(dirname "$0")/lib.sh"
rewrites=$(cat)
run_own "$@" <<<"$rewrites"   # git ignores this hook's exit status
enabled all || exit 0
read -r old new _ <<<"$rewrites"

case "$1" in
  amend)
    # A commit nobody has seen yet can be amended in peace.
    if enabled amend && [ "$old" != "$new" ] && git branch -r --contains "$old" 2>/dev/null | grep -q .; then
      play amend --commits 1 --msg "$(git log -1 --format=%s "$new")" --remote "$(repo_name)"
    fi ;;
  rebase)
    # `git pull --rebase` labels its work "pull ..."; after stopping on a conflict and continuing,
    # the label is left only in the rebase's "(start)" entry in HEAD's reflog.
    if [[ "${GIT_REFLOG_ACTION:-}" == pull* || "$(git reflog --format=%gs | grep -m1 -- ' (start): ')" == pull* ]]; then
      # The first rewritten commit sits right on top of the new base, so $old..$onto is what came in.
      onto=$(git rev-parse -q --verify "$new^") && pull_reaction "$old" "$onto"
      exit 0
    fi
    count=$(grep -c . <<<"$rewrites")
    if enabled rebase && [ "$count" -ge 3 ]; then
      play rebase --commits "$count" --msg "$(git log -1 --format=%s HEAD)" --remote "$(repo_name)"
    fi ;;
esac
exit 0
